# NEXORA Environment Configuration Template
PROJECT_NAME="NEXORA Education ERP"
VERSION="1.0.0"
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# Security
SECRET_KEY="replace_this_with_a_secure_random_secret_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local SQLite fallback: sqlite:///./nexora.db
# Production PostgreSQL: postgresql+asyncpg://postgres:password@localhost:5432/nexora_db
DATABASE_URL="sqlite:///./nexora.db"

# CORS Origins (JSON formatted array of URLs)
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000", "http://127.0.0.1:5173"]
